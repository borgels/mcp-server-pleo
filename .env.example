PLEO_API_KEY=
# PLEO_ACCESS_TOKEN=
PLEO_BASE_URL=https://external.pleo.io
PLEO_TIMEOUT_MS=30000
# PLEO_AUDIT_LOG=/absolute/path/to/pleo-audit.jsonl

# Optional governed writes:
# PLEO_ENABLE_WRITES=false
# PLEO_POLICY_PATH=/absolute/path/to/pleo-policy.json

# Optional Streamable HTTP hardening:
MCP_HTTP_HOST=127.0.0.1
PORT=3000
MCP_MAX_BODY_BYTES=10485760
